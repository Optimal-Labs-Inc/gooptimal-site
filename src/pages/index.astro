---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GatewayCanvas from "../components/GatewayCanvas.astro";
import VetBadge from "../components/VetBadge.astro";
import ArchitectureDiagram from "../components/ArchitectureDiagram.astro";
import { capabilityStatementHref } from "../data/company.ts";

const standards = [
  "NIST AI RMF", "OWASP LLM Top 10", "MITRE ATLAS", "NIST CSF 2.0",
  "NIST 800-207", "CISA Secure by Design", "SLSA", "ISO 42001",
];

// The three pillars: infrastructure that stays up, AI that watches it, and a
// supply chain you can account for from model to package to pipeline.
const pillars = [
  {
    tag: "Resilient infrastructure",
    title: "Built for systems that can't go down",
    body: "We build the governed AI infrastructure critical infrastructure runs on: one authenticated gateway to the models you approve, fail-closed guardrails, default-deny egress, and an audit trail you own. Deployed in your cloud, on-prem, or fully air-gapped, and designed to keep operating when something upstream breaks.",
    points: ["Governed AI gateway", "Zero Trust architecture", "Air-gap capable", "Fail-closed by design"],
    href: "/#how",
    cta: "See the architecture →",
  },
  {
    tag: "AI threat detection",
    title: "AI that detects AI threats",
    body: "Attackers are using AI, and the AI you deploy is now part of the attack surface. Our detection sits inline on every prompt and response, catching injection, jailbreaks, data exfiltration, and agent abuse before they reach a model or a system. We red-team the same systems to find what detection alone would miss.",
    points: ["Inline prompt & response detection", "Agent and tool-use monitoring", "Adversarial AI red-teaming", "AI security assessments"],
    href: "/#process",
    cta: "How an engagement runs →",
  },
  {
    tag: "Supply chain security",
    title: "Across the entire stack",
    body: "Every system is only as trustworthy as what it is built from. 9line maps the full supply chain, from code and open-source packages to container images and AI models, separates what is reachable from what is noise, and produces a machine-readable record of every determination.",
    points: ["SBOM & AI-BOM", "Reachability analysis", "VEX evidence", "Containers to models"],
    href: "/nineline",
    cta: "Explore 9line →",
  },
];

// Advisory-led services — the four engagements Optimal runs, arced
// find it → prove it → build the controls → keep the program governed.
// Each carries concrete scope and a named deliverable, not benefit copy.
// Standard security-assessment methodology, written to AI systems.
const phases = [
  {
    idx: "01",
    n: "Scope",
    d: "We define the systems in play, the data they touch, the threat model that actually matters to you, and the rules of engagement. The scope is written to your stack — not lifted from a template.",
  },
  {
    idx: "02",
    n: "Map the attack surface",
    d: "We inventory every way in and out: models, prompts, retrieval sources, tools and functions, identities, credentials, and egress paths. You can't secure what hasn't been mapped.",
  },
  {
    idx: "03",
    n: "Test like an adversary",
    d: "We run the OWASP LLM Top 10 and MITRE ATLAS techniques against your systems — injection, extraction, manipulation, abuse-case chains — and document what works, with evidence.",
  },
  {
    idx: "04",
    n: "Report for two audiences",
    d: "Ranked findings, reproduction steps, business impact, and specific remediation — written for the engineers who fix it and the leaders who own the risk.",
  },
  {
    idx: "05",
    n: "Remediate & retest",
    d: "We help close the findings, then prove they're closed. The engagement ends with evidence, not a backlog of open items.",
  },
];

// OWASP Top 10 for LLM Applications (2025) — the threat taxonomy we test to.
const owasp = [
  ["LLM01", "Prompt Injection"],
  ["LLM02", "Sensitive Information Disclosure"],
  ["LLM03", "Supply Chain"],
  ["LLM04", "Data & Model Poisoning"],
  ["LLM05", "Improper Output Handling"],
  ["LLM06", "Excessive Agency"],
  ["LLM07", "System Prompt Leakage"],
  ["LLM08", "Vector & Embedding Weaknesses"],
  ["LLM09", "Misinformation"],
  ["LLM10", "Unbounded Consumption"],
];

const flow = [
  {
    idx: "01",
    n: "Authorize",
    stack: "Cloudflare Access · Okta OIDC",
    d: "Authenticate the caller, then check the request against a model and resource allowlist. No token is issued for a model you haven't approved.",
  },
  {
    idx: "02",
    n: "Guard",
    stack: "NeMo Guardrails · PII/secret detectors",
    d: "Inline detection on prompt and response — injection, jailbreak, PII/DLP, secret exfiltration — fail-closed and pre-call. A blocked request never reaches the provider.",
  },
  {
    idx: "03",
    n: "Forward",
    stack: "LiteLLM keys · Squid egress",
    d: "Proxy to the approved model — commercial, GovCloud, or self-hosted — through per-key virtual credentials, with egress pinned to a default-deny allowlist.",
  },
  {
    idx: "04",
    n: "Prove",
    stack: "Structured JSON · Postgres",
    d: "Write a structured audit row joined by request ID — the artifact your reviewers read directly, on your retention, in your account.",
  },
];

// OWASP Top 10 for LLM Applications (2025) — the threat taxonomy we test to.
const faqs = [
  {
    q: "What does Optimal do?",
    a: "Optimal builds governed AI infrastructure for critical infrastructure. We engineer systems to stay resilient, deploy AI that detects AI-driven and other emerging threats against them, and secure the software and AI supply chain across the entire stack, from code and packages to containers and models. We're an SBA-certified Service-Disabled Veteran-Owned Small Business (SDVOSB).",
  },
  {
    q: "What is governed AI?",
    a: "Governed AI means every use of a model is authorized, inspected, and recorded. Requests pass through one authenticated gateway, guardrails check prompts and responses before anything reaches a model or a system, egress is pinned to an allowlist, and every call leaves an audit record in your own account. It is how an operator puts AI to work on critical systems without losing control of it.",
  },
  {
    q: "How does Optimal's AI detect AI threats?",
    a: "Detection runs inline, on every prompt and every response: prompt injection, jailbreaks, sensitive-data and secret exfiltration, and agents reaching for tools or resources they were never granted. Requests that fail are blocked before they reach the provider, fail-closed. We pair that with adversarial red-teaming against the OWASP LLM Top 10 and MITRE ATLAS, so the detection is tested against how these systems actually get attacked.",
  },
  {
    q: "What does supply-chain security across the entire stack mean?",
    a: "It means accounting for everything a system is built from, not just the application code: open-source packages, container images and their OS layers, build pipelines, and the AI models and datasets in use. 9line inventories all of it, works out which vulnerabilities are actually reachable, and records each determination as machine-readable VEX that downstream teams and tools can verify.",
  },
  {
    q: "What is 9line?",
    a: "9line is Optimal's AI-native application and supply-chain security platform: real SBOM and vulnerability scanning, EPSS and CISA KEV enrichment, and reachability analysis that reads your actual codebase, turning thousands of raw findings into an evidence-backed action queue and an exportable VEX record. In the reference scan it compressed 874 raw findings to the 18 that required action. It deploys in your environment, air-gap capable, with a live demonstrator at 9line.gooptimal.io.",
  },
  {
    q: "Can you work in the cloud we already have?",
    a: "Yes, and it's often the fastest path. We build governed, audited access to the frontier models already available in the cloud you license, including Azure OpenAI Service, Amazon Bedrock, and Google Vertex AI, so your teams reach them safely without a new vendor or procurement. We also deploy on-prem and in fully air-gapped networks.",
  },
  {
    q: "Who does Optimal work with?",
    a: "Operators of critical infrastructure and the teams that build for them: energy and utilities, water, transportation, communications, healthcare, financial services, the defense industrial base, and federal, state, local, and education agencies. Optimal is an SBA-certified Service-Disabled Veteran-Owned Small Business (SDVOSB), eligible for SDVOSB and VOSB set-aside contracts.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout
  title="Optimal | Governed AI for critical infrastructure"
  description="Optimal builds governed AI infrastructure for critical infrastructure: resilient systems, AI that detects AI-driven and emerging threats, and supply-chain security across the entire stack, from code and packages to containers and models. An SBA-certified Service-Disabled Veteran-Owned Small Business (SDVOSB)."
  jsonLd={[faqSchema]}
>
  <Header />

  <!-- HERO -->
  <section class="hero relative">
    <div class="glow"></div>
    <GatewayCanvas variant="hero" />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="container z">
      <span class="eyebrow">Governed AI · Critical infrastructure · SDVOSB</span>
      <h1 class="display">Governed AI for critical infrastructure.<br /><span class="grad">Built resilient. Defended by AI.</span></h1>
      <p class="lead">
        Optimal builds the infrastructure critical systems run on, deploys AI that
        detects AI-driven and emerging threats against them, and secures the supply
        chain across the entire stack, from code and packages to containers and models.
      </p>
      <div class="cta-row">
        <a href="/contact" class="btn btn-primary">Book a scoping call →</a>
        <a href="/nineline" class="btn btn-ghost">Explore 9line →</a>
      </div>
      <div class="hero-meta muted">
        <span>Sovereign by default</span><span class="dot">•</span>
        <span>Supply chain, end to end</span><span class="dot">•</span>
        <span>SDVOSB-certified</span>
      </div>
    </div>
  </section>

  <!-- STANDARDS WALL + VET STRIP -->
  <section id="standards" class="section--tight standards">
    <div class="container">
      <p class="wall-label muted">Engineered and measured to the standards that gate production AI</p>
      <div class="wall">
        {standards.map((s) => <span class="chip">{s}</span>)}
      </div>
      <div class="vet-strip">
        <VetBadge size={84} />
        <div class="vet-copy">
          <p class="vet-note muted">
            Optimal, LLC is a <strong>Service-Disabled Veteran-Owned Small Business</strong> —
            SBA-certified and eligible for veteran set-aside contracts. CAGE 14HQ0 · UEI TYMSGKDF2K48.
          </p>
          <a href={capabilityStatementHref} class="usecase-link">Download capability statement →</a>
        </div>
      </div>
      <!-- Proof of work: no customer logos yet, so the evidence is the work itself. -->
      <div class="proof-row">
        <a class="proof" href="https://github.com/optimal-cyber/AI-Gateway">
          <span class="proof-k">Open reference architecture</span>
          <span class="proof-v muted">The Zero Trust AI gateway, public on GitHub ↗</span>
        </a>
        <a class="proof" href="/whitepapers/securing-agentic-ai/">
          <span class="proof-k">Published whitepaper</span>
          <span class="proof-v muted">Securing Agentic AI — threat model to control crosswalk</span>
        </a>
        <a class="proof" href="/blog">
          <span class="proof-k">Field notes</span>
          <span class="proof-v muted">How we think about governed AI, supply chains, and agents</span>
        </a>
      </div>
      <!-- Client testimonial: wording and attribution approved by the client (Oct 29, 2026). Title only, no name or company. -->
      <figure class="testimonial">
        <blockquote>
          <p>&ldquo;Optimal assessed the Azure sandbox where our AI agents are being built before anything
          went live. The report was clear and prioritized, gave us a straight answer on where the build
          actually stood, and we could act on it right away. Fast turnaround and easy to work
          with.&rdquo;</p>
        </blockquote>
        <figcaption>
          <span class="t-name">IT Director / CRE Developer</span>
          <span class="t-title muted">AI security assessment client</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 9line — product spotlight -->
  <section id="nineline" class="section nl-spot relative">
    <div class="glow"></div>
    <div class="container z">
      <div class="sec-head wide">
        <span class="ix">9line · Live demonstrator</span>
        <h2 class="h2">9line. Your 9-line for software and AI.</h2>
        <p class="lead" style="margin-top:14px;">
          AI-native application and supply-chain security, running. Real SBOM and vulnerability
          scanning, EPSS and CISA KEV enrichment, and frontier-model reachability analysis that
          reads your actual codebase — turning thousands of raw findings into an evidence-backed
          action queue and an exportable VEX record. Deployed in your environment, air-gap capable.
        </p>
      </div>
      <div class="spot-stats">
        <div class="spot-stat">
          <span class="spot-num">874</span>
          <span class="spot-label">Raw findings in</span>
        </div>
        <span class="spot-arrow" aria-hidden="true">→</span>
        <div class="spot-stat lit">
          <span class="spot-num grad">18</span>
          <span class="spot-label">Require action</span>
        </div>
        <div class="spot-stat">
          <span class="spot-num spot-green">−97.9%</span>
          <span class="spot-label">Noise eliminated</span>
        </div>
      </div>
      <div class="cta-row">
        <a href="https://9line.gooptimal.io/" class="btn btn-primary" target="_blank" rel="noopener">Explore the live demo →</a>
        <a href="/nineline" class="btn btn-ghost">How 9line works</a>
      </div>
    </div>
  </section>

  <!-- PILLARS — what Optimal does, at a glance -->
  <section id="pillars" class="section pillars relative">
    <div class="glow"></div>
    <div class="container z">
      <div class="sec-head wide">
        <span class="ix">What we do</span>
        <h2 class="h2">Three things, built to work together.</h2>
        <p class="lead" style="margin-top:14px;">Critical infrastructure is adopting AI, and adversaries are using it too. Optimal builds the resilient foundation, the AI that watches it, and the supply-chain record underneath it, from one veteran-owned partner.</p>
      </div>
      <div class="pillar-grid">
        {pillars.map((p) => (
          <article class="card pillar">
            <span class="tag">{p.tag}</span>
            <h3>{p.title}</h3>
            <p class="muted pillar-body">{p.body}</p>
            <ul class="pillar-points">
              {p.points.map((pt) => <li>{pt}</li>)}
            </ul>
            <a href={p.href} class="usecase-link">{p.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ARCHITECTURE / HOW IT WORKS -->
  <section id="how" class="section how relative">
    <div class="glow"></div>
    <div class="container z">
      <div class="sec-head wide">
        <span class="ix">9line · The reference implementation</span>
        <h2 class="h2">Agents in. Approved resources out.<br />Everything in between, governed.</h2>
        <p class="lead" style="margin-top:14px;">This is <strong>9line</strong> — your 9-line for software and AI, and the working proof behind our Governed AI Engineering. The same open-source Zero Trust design we stand up in your environment, running.</p>
        <div class="nl-ctas">
          <a class="btn btn-ghost" href="/nineline">See 9line running →</a>
          <a class="inline-link" href="https://github.com/optimal-cyber/AI-Gateway">Read the architecture ↗</a>
        </div>
      </div>
      <ArchitectureDiagram steps={flow} />
      <p class="muted note">No wrapper, no SDK rewrite — point your existing OpenAI- or Anthropic-compatible client at the gateway and every call is governed and logged.</p>
    </div>
  </section>

            <!-- METHODOLOGY / PROCESS -->
  <section id="process" class="section process relative">
    <div class="glow"></div>
    <div class="container z">
      <div class="sec-head wide">
        <span class="ix">03 / Process</span>
        <h2 class="h2">How an engagement runs.</h2>
        <p class="lead" style="margin-top:14px;">A working method, not a black box. You see the attack surface as we map it, the findings as we prove them, and the fixes as they close.</p>
      </div>
      <ol class="timeline">
        {phases.map((p) => (
          <li class="phase">
            <div class="phase-node"><span>{p.idx}</span></div>
            <div class="phase-body">
              <h4>{p.n}</h4>
              <p class="muted">{p.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

        <!-- FAQ -->
  <section id="faq" class="section faq relative">
    <div class="glow"></div>
    <div class="container z">
      <div class="sec-head wide">
        <span class="ix">06 / FAQ</span>
        <h2 class="h2">Questions we get first.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>
              <span class="faq-q">{f.q}</span>
              <span class="faq-mark" aria-hidden="true"></span>
            </summary>
            <p class="muted faq-a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

    <!-- CTA -->
  <!-- WHO YOU'RE HIRING — services are bought on the person; put the person on the page. -->
  <section id="founder" class="section--tight relative">
    <div class="container">
      <div class="card founder-card">
        <img class="founder-photo" src="/team/ryan-gutwein.jpg" alt="Ryan Gutwein, founder and CEO of Optimal" width="112" height="112" loading="lazy" />
        <div class="founder-copy">
          <span class="ix">Who you&rsquo;re hiring</span>
          <h2 class="founder-name">Ryan Gutwein</h2>
          <p class="muted founder-bio">
            Founder &amp; CEO. Former lead security assessor (TS/SCI, CISSP, CCSP)
            and a U.S. Air Force Security Forces veteran, now building and breaking agentic
            systems for critical infrastructure. Scoping calls are run by Ryan, not a sales team.
          </p>
          <div class="founder-links">
            <a class="usecase-link" href="/team">Meet the team →</a>
            <a class="usecase-link" href="https://fermentedopinions.substack.com/">Fermented Opinions ↗</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section cta relative">
    <div class="glow"></div>
    <GatewayCanvas variant="ambient" align="center" density={0.7} />
    <div class="container z cta-inner">
      <h2 class="display" style="font-size:clamp(2rem,5vw,3.4rem);">Let&rsquo;s scope<br />the work.</h2>
      <p class="lead" style="margin:18px auto 0;">Tell us the systems you run and the threats you&rsquo;re worried about. We&rsquo;ll scope the engagement: governed AI infrastructure, AI threat detection and red-teaming, or supply-chain security with 9line. Calls are run by the founder.</p>
      <a href="/contact" class="btn btn-primary" style="margin-top:28px;">Book a scoping call →</a>
    </div>
  </section>

  <Footer />

</Layout>

<style>
  .nl-ctas { margin-top: 20px; display: flex; flex-wrap: wrap; align-items: center; gap: 18px; }
  .founder-card { display: grid; gap: 22px; align-items: center; }
  .founder-photo { width: 112px; height: 112px; border-radius: 50%; object-fit: cover; border: 1px solid var(--rule-strong); }
  .founder-name { font-size: 1.35rem; margin-top: 10px; }
  .founder-bio { margin-top: 10px; font-size: 14.5px; line-height: 1.65; max-width: 62ch; }
  .founder-links { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 22px; }
  @media (min-width: 720px) { .founder-card { grid-template-columns: auto 1fr; gap: 32px; } }

  /* Keeps hero copy legible over the brightest part of the constellation. */
  .hero-scrim {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(90deg, rgba(8,9,13,0.92) 0%, rgba(8,9,13,0.66) 52%, rgba(8,9,13,0) 82%);
  }
  .proof-row { margin-top: 28px; padding-top: 24px; border-top: 1px solid var(--rule); display: grid; gap: 18px; }

  /* Client testimonial */
  .testimonial {
    margin: 34px 0 0; padding: 26px 30px;
    border: 1px solid var(--rule); border-left: 3px solid var(--sunset);
    border-radius: var(--radius-sm); background: var(--surface-2);
    max-width: 74ch;
  }
  .testimonial blockquote { margin: 0; }
  .testimonial blockquote p {
    font-family: var(--font-display); font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.5; letter-spacing: -0.01em; color: var(--text); margin: 0;
  }
  .testimonial figcaption { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline; }
  .t-name { font-weight: 600; color: var(--text); }
  .t-title { font-size: 13.5px; }
  .proof { display: grid; gap: 4px; text-decoration: none; }
  .proof-k { font-size: 14px; font-weight: 600; color: var(--text); }
  .proof:hover .proof-k { color: var(--sunset); }
  .proof-v { font-size: 12.5px; }
  @media (min-width: 820px) { .proof-row { grid-template-columns: 1fr 1fr 1fr; gap: 32px; } }

  /* Shared editorial section-index kicker */
  .ix {
    display: inline-block; font-family: var(--font-mono); font-size: 12px;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-faint);
    margin-bottom: 16px;
  }
  .sec-head.wide { max-width: 62ch; }
  .inline-link { color: var(--sunset); font-weight: 600; }
  .inline-link:hover { color: var(--ember); }

  /* PILLARS */
  .pillars { background: var(--bg); }
  .pillar-grid { display: grid; gap: 20px; margin-top: 42px; }
  @media (min-width: 820px) { .pillar-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1080px) {
    .pillar-grid { grid-template-columns: repeat(3, 1fr); }
    .pillar .pillar-points { grid-template-columns: 1fr; }
  }
  .pillar { display: flex; flex-direction: column; }
  .pillar h3 { font-size: 1.4rem; margin: 14px 0 12px; }
  .pillar-body { font-size: 14.5px; line-height: 1.7; }
  .pillar-points {
    list-style: none; margin: 20px 0 0; padding: 18px 0 0;
    border-top: 1px solid var(--rule);
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 9px 18px;
  }
  .pillar-points li {
    position: relative; padding-left: 18px; font-size: 13px; color: var(--text-dim); line-height: 1.45;
  }
  .pillar-points li::before {
    content: ""; position: absolute; left: 2px; top: 7px; width: 5px; height: 5px;
    border-radius: 1px; background: var(--sunset); transform: rotate(45deg); opacity: 0.85;
  }
  .pillar .usecase-link { margin-top: auto; padding-top: 22px; }


  /* HERO */
  .hero { padding: clamp(72px, 12vw, 150px) 0 clamp(48px, 7vw, 90px); }
  .hero .eyebrow { margin-bottom: 22px; }
  .hero h1 { margin-bottom: 24px; }
  .hero .lead { font-size: clamp(17px, 2.2vw, 21px); }
  .hero-caps {
    margin-top: 22px; font-family: var(--font-mono); font-size: 12.5px;
    letter-spacing: 0.06em; color: var(--text-dim); text-transform: uppercase;
  }
  .hero-caps span { color: var(--text-faint); margin: 0 4px; }
  .cta-row { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }

  /* 9line spotlight */
  .nl-spot { background: var(--surface); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .spot-stats {
    display: flex; flex-wrap: wrap; align-items: stretch; gap: 14px 10px;
    margin-top: 36px;
  }
  .spot-stat {
    flex: 1 1 170px; min-width: 150px; display: flex; flex-direction: column; gap: 8px;
    padding: 22px 24px; border: 1px solid var(--rule); border-radius: var(--radius);
    background: var(--surface-2);
  }
  .spot-stat.lit { border-color: rgba(255, 138, 61, 0.4); background: linear-gradient(160deg, rgba(255, 138, 61, 0.12), var(--surface-2)); }
  .spot-num { font-family: var(--font-display); font-weight: 700; font-size: clamp(2rem, 5vw, 3rem); line-height: 1; letter-spacing: -0.02em; }
  .spot-green { color: var(--seafoam); }
  .spot-label { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-dim); }
  .spot-arrow { align-self: center; color: var(--sunset); font-size: 22px; flex: 0 0 auto; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 30px; font-size: 13px; }
  .cta-aside { margin-top: 18px; font-size: 13.5px; }
  .cta-aside a { color: var(--sunset); font-weight: 600; }
