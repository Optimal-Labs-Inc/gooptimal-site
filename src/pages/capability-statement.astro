---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import VetBadge from "../components/VetBadge.astro";
import {
  CAGE,
  UEI,
  NAICS_CODES,
  PAST_PERFORMANCE,
  pending,
} from "../data/company.ts";

// One-page capability statement, built from content already asserted elsewhere
// on the site so the two can't drift apart. Everything here is either confirmed
// registration data or a restatement of an existing service description —
// nothing is written for this page alone. Styled to print to a clean PDF, which
// is what a contracting officer will actually do with it.

const competencies = [
  {
    title: "Governed AI infrastructure",
    body: "Resilient AI infrastructure for operators of critical systems: one authenticated gateway to every approved model, per-key virtual credentials, fail-closed prompt and response guardrails, default-deny egress, and a request-ID-joined audit trail. Deployed in the client's cloud, on-prem, or air-gapped, and client-owned.",
  },
  {
    title: "AI threat detection",
    body: "Inline detection of AI-driven and emerging threats on every prompt and response: prompt injection, jailbreaks, sensitive-data and secret exfiltration, and agent or tool-use abuse, blocked fail-closed before reaching a model or system.",
  },
  {
    title: "Software & AI supply chain security",
    body: "Supply-chain security across the entire stack with 9line: SBOM and AI-BOM generation, vulnerability scanning with EPSS and CISA KEV enrichment, reachability analysis, and machine-readable VEX evidence covering code, open-source packages, container images, and AI models.",
  },
  {
    title: "AI security assessment & adversarial testing",
    body: "Structured evaluation and offensive red-team testing of AI-enabled systems and agents: prompt injection, system-prompt extraction, model and context manipulation, data and model exfiltration, and excessive-agency chains. Measured to the OWASP LLM Top 10, MITRE ATLAS, and the NIST AI RMF.",
  },
];

const differentiators = [
  {
    title: "The infrastructure, the detection, and the supply chain, from one vendor",
    body: "Most AI vendors sell a model or a dashboard. Optimal builds the resilient foundation, the AI that watches it, and the supply-chain record underneath it, so the governed path is also the fastest one.",
  },
  {
    title: "The client owns the environment",
    body: "Not a hosted service. The infrastructure, the data, the keys, and the audit logs belong to the client. Replacing Optimal does not mean migrating data out of a vendor's boundary.",
  },
  {
    title: "Published reference architecture",
    body: "The control pattern Optimal implements is open source and inspectable before an engagement starts, and the client keeps operating it afterward. 9line, the AI-native supply-chain security platform, runs inside the client boundary and is air-gap capable.",
  },
  {
    title: "Independence preserved",
    body: "Optimal builds systems to stand up to an independent assessment. Optimal does not perform that assessment and does not grant authorizations. Building the environment and grading it are deliberately separate roles.",
  },
];

const companyData = [
  { k: "Legal name", v: "Optimal, LLC" },
  { k: "CAGE code", v: CAGE },
  { k: "UEI", v: UEI },
  ...(pending(NAICS_CODES) ? [] : [{ k: "NAICS", v: NAICS_CODES }]),
  { k: "Set-aside status", v: "SDVOSB and VOSB — SBA-certified via VetCert" },
  { k: "Contact", v: "ryan@gooptimal.io" },
  { k: "Website", v: "gooptimal.io" },
];
---

<Layout
  title="Capability statement — Optimal, LLC (SDVOSB)"
  description="Capability statement for Optimal, LLC — an SBA-certified Service-Disabled Veteran-Owned Small Business delivering governed AI infrastructure for critical infrastructure, AI threat detection, software and AI supply-chain security, and AI security assessment. CAGE 14HQ0 · UEI TYMSGKDF2K48."
  keywords="Optimal LLC capability statement, SDVOSB capability statement, CAGE 14HQ0, UEI TYMSGKDF2K48, governed AI, critical infrastructure security, AI threat detection, supply chain security, SBOM, VEX, AI security, set-aside contractor"
  breadcrumbs={[{ name: "Home", href: "/" }]}
>
  <Header />

  <section class="section--tight capstate">
    <div class="container">
      <header class="cap-head">
        <div class="cap-title">
          <span class="eyebrow">Capability statement</span>
          <h1 class="h2">Optimal, LLC</h1>
          <p class="lead" style="margin-top:14px;">
            Governed AI for critical infrastructure: resilient systems, AI that detects AI-driven and
            emerging threats, and supply-chain security across the entire stack. An SBA-certified
            Service-Disabled Veteran-Owned Small Business.
          </p>
        </div>
        <VetBadge size={96} />
      </header>

      <div class="cap-grid">
        <section class="cap-block">
          <h2 class="cap-h">Core competencies</h2>
          <ul class="cap-list">
            {competencies.map((c) => (
              <li>
                <h3>{c.title}</h3>
                <p class="muted">{c.body}</p>
              </li>
            ))}
          </ul>
        </section>

        <section class="cap-block">
          <h2 class="cap-h">Differentiators</h2>
          <ul class="cap-list">
            {differentiators.map((d) => (
              <li>
                <h3>{d.title}</h3>
                <p class="muted">{d.body}</p>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <section class="cap-block">
        <h2 class="cap-h">Past performance</h2>
        {PAST_PERFORMANCE.length > 0 ? (
          <ul class="cap-list two">
            {PAST_PERFORMANCE.map((r) => (
              <li>
                <h3>{r.title}</h3>
                <p class="muted">{r.detail}</p>
              </li>
            ))}
          </ul>
        ) : (
          <p class="muted cap-note">
            References available on request. Optimal does not publish customer names or engagement
            details without written permission — including, and especially, for work on critical
            systems.
          </p>
        )}
      </section>

      <section class="cap-block">
        <h2 class="cap-h">Company data</h2>
        <dl class="cap-data">
          {companyData.map((d) => (
            <div class="cap-row">
              <dt>{d.k}</dt>
              <dd>{d.v}</dd>
            </div>
          ))}
        </dl>
        <p class="muted cap-note">
          Optimal builds systems to stand up to an independent assessment. Optimal does not perform
          that assessment and does not grant authorizations.
        </p>
      </section>

      <div class="cap-cta">
        <a href="/contact" class="btn btn-primary">Book a scoping call →</a>
        <a href="/nineline" class="btn btn-ghost">Explore 9line</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .capstate { background: var(--bg); }
  .cap-head {
    display: flex; flex-wrap: wrap; gap: 28px; align-items: flex-start;
    justify-content: space-between; padding-bottom: 34px; border-bottom: 1px solid var(--rule);
  }
  .cap-title { max-width: 62ch; }
  .cap-grid { display: grid; gap: 40px; }
  @media (min-width: 900px) { .cap-grid { grid-template-columns: repeat(2, 1fr); gap: 56px; } }
  .cap-block { margin-top: 40px; }
  .cap-h {
    font-family: var(--font-mono); font-size: 12px; font-weight: 500;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-faint);
    padding-bottom: 14px; border-bottom: 1px solid var(--rule);
  }
  .cap-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; padding-top: 22px; }
  @media (min-width: 900px) { .cap-list.two { grid-template-columns: repeat(2, 1fr); gap: 22px 56px; } }
  .cap-list h3 { font-size: 1.05rem; margin-bottom: 8px; }
  .cap-list p { font-size: 13.5px; line-height: 1.65; }
  .cap-note { margin-top: 20px; font-size: 13.5px; line-height: 1.7; max-width: 74ch; }
  .cap-data { margin: 22px 0 0; display: grid; gap: 0; }
  .cap-row {
    display: grid; gap: 4px; padding: 12px 0; border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 600px) { .cap-row { grid-template-columns: 200px 1fr; gap: 18px; align-items: baseline; } }
  .cap-data dt {
    font-family: var(--font-mono); font-size: 11px; text-transform: uppercase;
    letter-spacing: 0.14em; color: var(--text-faint);
  }
  .cap-data dd { margin: 0; font-size: 14.5px; color: var(--text); }
  .cap-cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 44px; }

  /* A contracting officer prints this. Make the print look like a document. */
  @media print {
    :global(.site-header), :global(.site-footer), .cap-cta { display: none !important; }
    .capstate { padding: 0; }
    .cap-block { break-inside: avoid; }
  }
</style>
